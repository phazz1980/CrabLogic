# ESP32-C3 DevKit, console on the built-in USB (USB Serial/JTAG), as the C++ master uses it.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# MQTT over plain TCP only (no TLS / WebSocket transports): keeps the image small.
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=n
# The master never serves TLS (esp-tls is linked by the plain TCP transport of MQTT).
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# Ethernet over SPI with a W5500 module (driver in polling mode, no INT wire).
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# The continuous ADC (analog inputs) keeps sampling while a module is written to flash: its ISR must
# live in IRAM, or an interrupt with the flash cache off crashes the board.
CONFIG_ADC_CONTINUOUS_ISR_IRAM_SAFE=y
