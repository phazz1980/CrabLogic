/target
# Build folders of block sources (skills/crablogic-block: blocks_src/<type>/)
/blocks_src/*/target/
# Per-project build cache
.crab/

# Bundled Arduino libraries (FLProg_Network, Modbus...), kept locally
/Flprog_Network/

# Distribution archive
/dist/

# Local zig compiler for block simulation
/tools/
.flp/

# Build folder of the Rust master firmware (firmware/master-rs, short path for ESP-IDF)
/.m/
/.embuild/
/.llvm/

# Bench reports and the real Wi-Fi/MQTT settings of the bench stands
/bench/*.toml
!/bench/secrets.example.toml
